# Backend environment — copy to backend/config/.env (git-ignored) or set these
# as real environment variables on the host (Railway, xCloud, cPanel, …).

# Database (falls back to localhost/root/shopify_reviews when unset)
# DB_HOST=localhost
# DB_NAME=shopify_reviews
# DB_USER=root
# DB_PASS=
# DB_PORT=3306

# Slack bot token used to post "Review Earned By" celebrations to the team
# channel. Create a Slack app, add the `chat:write` bot scope, install it to the
# workspace, invite the bot to the channel, then paste its Bot User OAuth Token.
# Without this the assignment still saves — the notification is just skipped.
SLACK_BOT_TOKEN="xoxb-your-bot-token-here"
